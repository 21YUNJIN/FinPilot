# 融策智能体（FinPilot）环境配置示例
# 复制为 .env 后按本机实际情况修改；.env 不进入版本库，且不得包含真实生产密钥。

# --- 数据库 ---
# 主库：事务、账本、授权、操作、审计
DATABASE_URL=postgresql+psycopg://finpilot:finpilot_dev_pw@127.0.0.1:55432/finpilot
# 测试库：集成/并发/安全测试专用，测试会话会重建全部表
TEST_DATABASE_URL=postgresql+psycopg://finpilot:finpilot_dev_pw@127.0.0.1:55432/finpilot_test
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- 运行模式 ---
# live        : 在线模型运行（需要 MODEL_BASE_URL / MODEL_API_KEY）
# offline_replay: 离线重放冻结轨迹（明确标记，不冒充实时）
# mock        : 无模型，使用确定性脚本智能体（本地开发与确定性测试）
APP_MODE=mock
ENVIRONMENT=local

# --- 模型适配器（可选） ---
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_TEMPERATURE=0.0
MODEL_MAX_RETRIES=2
MODEL_TIMEOUT_SECONDS=30

# --- 会话与验证（本地开发占位值，禁止用于任何真实环境） ---
SESSION_TTL_MINUTES=120
# 用于加密保存 TOTP 秘钥；32 字节 base64url 字符串
TOTP_ENCRYPTION_KEY=dev_only_totp_key_change_me_0123456789abcdef
# 审计链独立签名摘要密钥（与数据库账号分离保存）
AUDIT_SIGNING_KEY=dev_only_audit_signing_key_change_me
# 提供方回调共享密钥（沙箱银行/商户）
PROVIDER_CALLBACK_SECRET=dev_only_provider_callback_secret

# --- 业务参数（可追溯的工程阈值，非官方评分线）---
TRANSFER_DAILY_YELLOW_LIMIT_MINOR=100000
CHALLENGE_TTL_SECONDS=120
CHALLENGE_MAX_ATTEMPTS=5
CHALLENGE_LOCK_SECONDS=900
GRANT_EXACT_TTL_SECONDS=300
RESERVATION_IDLE_TTL_SECONDS=900
SCHEDULE_WINDOW_MINUTES=10
PLANNER_MAX_NODES=24
PLANNER_MAX_CANDIDATES=128
PLANNER_SOLVE_TIMEOUT_MS=2000
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_COOLDOWN_SECONDS=60
SAFETY_LOCK_REFUSAL_THRESHOLD=5
SAFETY_LOCK_WINDOW_SECONDS=60
SANDBOX_ENABLED=true
SANDBOX_CPU_SECONDS=5
SANDBOX_WALL_SECONDS=10
SANDBOX_MEMORY_MB=512
SANDBOX_OUTPUT_BYTES=1048576
SANDBOX_MAX_PROCESSES=32
AUDIT_RETENTION_DAYS=90
CHAT_RETENTION_DAYS=30

# --- 独立提供方沙箱（另一套进程 + 各自独立状态库）---
BANK_SANDBOX_BASE_URL=http://127.0.0.1:58101
MERCHANT_SANDBOX_BASE_URL=http://127.0.0.1:58102
# 状态库默认落在 <仓库根>/.state/ 下（见 finpilot/config.py），需要换位置时再显式指定绝对路径；
# 两者必须是不同文件。以下为示例，按本机实际情况取消注释：
# BANK_SANDBOX_STATE=D:/<你的目录>/.state/bank_sandbox.sqlite3
# MERCHANT_SANDBOX_STATE=D:/<你的目录>/.state/merchant_sandbox.sqlite3
# 通知主库回调的地址（提供方沙箱异步回执用）
PROVIDER_CALLBACK_BASE_URL=http://127.0.0.1:58000
# Integrated S3 HTTP service; keep its bearer token outside source control.
QUANT_BACKEND=remote
STOCKQUANT_SERVICE_URL=http://127.0.0.1:8770
STOCKQUANT_SERVICE_TOKEN=

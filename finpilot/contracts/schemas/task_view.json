{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finpilot.local/schemas/task_view.json",
  "title": "TaskView",
  "description": "权威任务视图：状态、修订、目标摘要、计划、进度、等待原因。等待人工、外部到账、重新授权或超限都不是成功（V5 第 7.1 节，STATE-04）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "owner_user_id",
    "channel",
    "status",
    "revision",
    "reference_time",
    "mode",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96
    },
    "owner_user_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 48
    },
    "channel": {
      "enum": [
        "app",
        "im",
        "operator"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "clarifying",
        "planning",
        "awaiting_authorization",
        "ready",
        "running",
        "reconciling",
        "replanning",
        "awaiting_human",
        "succeeded",
        "partially_succeeded",
        "failed",
        "cancelled",
        "blocked"
      ],
      "description": "与 models.TASK_STATUSES 逐字一致；转移由 kernel/state_machine.py 校验。"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "description": "计划／任务修订号，变更关键字段必须生成新修订。"
    },
    "reference_time": {
      "type": "string",
      "format": "date-time",
      "description": "带时区 ISO 8601 时间戳；持久化 UTC，展示 Asia/Shanghai。"
    },
    "mode": {
      "enum": [
        "live",
        "offline_replay",
        "mock"
      ],
      "description": "运行模式必须如实标注（SYS-04）。"
    },
    "goal_summary": {
      "type": "object",
      "description": "面向用户核对的结构化摘要，与参数同源。"
    },
    "goal": {
      "$ref": "https://finpilot.local/schemas/goal.json"
    },
    "clarifications": {
      "type": "array",
      "items": {
        "$ref": "https://finpilot.local/schemas/clarification.json"
      }
    },
    "plan_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 48
    },
    "plan": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "https://finpilot.local/schemas/plan.json"
        }
      ]
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "completed_steps": {
          "type": "integer",
          "minimum": 0
        },
        "total_steps": {
          "type": "integer",
          "minimum": 0
        },
        "completed_effects": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 255
          }
        },
        "pending_effects": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 255
          }
        }
      }
    },
    "waiting_reason": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "safe_message"
          ],
          "properties": {
            "code": {
              "enum": [
                "awaiting_authorization",
                "awaiting_human",
                "awaiting_funds",
                "awaiting_provider",
                "awaiting_reconciliation",
                "planning_limit"
              ]
            },
            "safe_message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "operation_id": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 64
            },
            "grant_id": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 48
            },
            "challenge_id": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 48
            }
          }
        }
      ]
    },
    "result_summary": {
      "type": "object",
      "description": "完成／未完成／未知的权威事实摘要，不依据模型措辞。"
    },
    "blocked_reason": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 255
    },
    "spent_minor": {
      "type": "integer",
      "minimum": 0,
      "description": "金额：整数人民币分（amount_minor）。禁止 number/浮点。"
    },
    "fee_minor": {
      "type": "integer",
      "minimum": 0,
      "description": "金额：整数人民币分（amount_minor）。禁止 number/浮点。"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "带时区 ISO 8601 时间戳；持久化 UTC，展示 Asia/Shanghai。"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "带时区 ISO 8601 时间戳；持久化 UTC，展示 Asia/Shanghai。"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "blocked"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "blocked_reason"
        ],
        "properties": {
          "blocked_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "awaiting_authorization"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "waiting_reason"
        ],
        "properties": {
          "waiting_reason": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "succeeded",
              "partially_succeeded",
              "failed",
              "cancelled"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "result_summary"
        ],
        "properties": {
          "result_summary": {
            "minProperties": 1
          }
        }
      }
    }
  ]
}

# FinPilot container environment -- copy to deploy/compose.env and edit.
#
#   cp deploy/compose.env.example deploy/compose.env
#   docker compose -f deploy/compose.yaml --env-file deploy/compose.env up -d
#
# deploy/compose.env is git-ignored on purpose: it holds the deployment's secret
# values. The values below are the DEV-ONLY placeholders used by the competition
# demo and by the local test environment; they must be replaced before any use
# outside the demo. This file itself never contains real production secrets.

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=finpilot
POSTGRES_PASSWORD=finpilot_dev_pw
POSTGRES_DB=finpilot
TEST_DATABASE_DB=finpilot_test

# --- runtime ------------------------------------------------------------------
# mock | offline_replay | live   (see README "运行模式")
APP_MODE=mock
ENVIRONMENT=container
API_WORKERS=1
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_LOCK_TIMEOUT_MS=20000
DB_IDLE_TX_TIMEOUT_MS=60000

# --- secret-bearing settings (REPLACE for anything beyond the demo) -----------
# 32-byte base64url string used to encrypt TOTP secrets at rest
TOTP_ENCRYPTION_KEY=dev_only_totp_key_change_me_0123456789abcdef
# HMAC key for the audit-chain signed digest; keep it OUTSIDE the backup medium
AUDIT_SIGNING_KEY=dev_only_audit_signing_key_change_me
# shared HMAC secret for provider callbacks (bank/merchant sandbox)
PROVIDER_CALLBACK_SECRET=dev_only_provider_callback_secret

# --- optional live-model settings (only used when APP_MODE=live) --------------
# MODEL_BASE_URL=
# MODEL_API_KEY=
# MODEL_NAME=
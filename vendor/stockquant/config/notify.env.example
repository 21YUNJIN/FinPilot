# Copy to ~/.config/stockquant/notify.env and fill in what you need.
# Every channel is optional; leave a line blank to disable that channel.
# NEVER commit the real file.

# Desktop notification (macOS)
STOCKQUANT_NOTIFY_MACOS=1

# 企业微信群机器人 webhook（群设置 -> 群机器人 -> 添加 -> 复制 Webhook 地址）
STOCKQUANT_WECOM_WEBHOOK=

# Server酱（https://sct.ftqq.com 扫码登录后获取 SendKey）
STOCKQUANT_SERVERCHAN_KEY=

# 邮件 SMTP（QQ 邮箱用授权码，不是登录密码）
STOCKQUANT_SMTP_HOST=
STOCKQUANT_SMTP_PORT=465
STOCKQUANT_SMTP_USER=
STOCKQUANT_SMTP_PASSWORD=
STOCKQUANT_SMTP_TO=

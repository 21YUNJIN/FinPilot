# Copy to ~/.config/stockquant/tushare.env and fill the token.
# Never commit the real file.
#
# Full statements / index weight APIs require a Tushare account with enough
# points (income_vip needs 5000+, balancesheet 2000+, fina_indicator 2000+).
TUSHARE_TOKEN=

# Optional: local Tutake DuckDB / parquet directory if you bulk-sync with
# https://github.com/rmfish/tutake instead of calling the API directly.
# STOCKQUANT_TUTAKE_DIR=/path/to/tutake/database
